rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ⚠️ GEÇİCİ TEST MODU: Herkese tam okuma ve yazma yetkisi verir.
    // Uygulamayı canlıya almadan önce eski güvenlikli versiyona geri döneceğiz!
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
